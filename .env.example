# Copy to .env and fill in your eBay production keyset.
# The Dev ID is not needed for the Browse API.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_ENVIRONMENT=production

# PriceCharting API token (Legendary plan): Subscription page > API/Download.
PRICECHARTING_TOKEN=

# Telegram bot token from @BotFather. Message the bot once, then run
# make telegram-chat-id to find the chat ID to send alerts to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: a daily window with no polls, saving eBay calls. Auctions
# ending then are searched for in the evening before it. Test alerts sent
# then arrive silently. TIMEZONE is an IANA name such as America/Los_Angeles.
TELEGRAM_QUIET_HOURS=00:00-05:00
TIMEZONE=America/Los_Angeles

# eBay Marketplace Account Deletion notifications, answered on the server.
# The token is made up: 32 to 80 letters, digits, _ or -. The endpoint is
# the public URL entered on eBay's developer portal, exactly.
EBAY_DELETION_TOKEN=
EBAY_DELETION_ENDPOINT=https://167-71-16-111.sslip.io/ebay/account-deletion
