# Copy to .env and fill in your eBay production keyset.
# The Dev ID is not needed for the Browse API.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_ENVIRONMENT=production

# PriceCharting API token (Legendary plan): Subscription page > API/Download.
PRICECHARTING_TOKEN=

# Telegram bot token from @BotFather. Message the bot once, then run
# make telegram-chat-id to find the chat ID to send alerts to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
